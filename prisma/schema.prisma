generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id         String   @id @default(cuid())
  namaProduk String   @map("nama_produk")
  satuan     String
  harga      Int      @default(0)
  stok       Int      @default(0)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  orderItems OrderItem[]
  @@map("products")
}

model Partner {
  id         String   @id @default(cuid())
  kodeMitra  String   @unique @map("kode_mitra")
  namaCabang String   @map("nama_cabang")
  namaPic    String   @map("nama_pic")
  whatsapp   String
  alamat     String   @default("")
  pinHash    String   @map("pin_hash")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  @@index([kodeMitra])
  @@map("partners")
}

model Order {
  id                String        @id @default(cuid())
  kodeMitra         String        @map("kode_mitra")
  namaCabang        String        @map("nama_cabang")
  namaPic           String        @map("nama_pic")
  whatsapp          String
  alamat            String
  catatan           String?
  totalHarga        Int           @default(0) @map("total_harga")
  status            String        @default("menunggu")
  paymentMethod     String        @default("cod") @map("payment_method")
  paymentStatus     String        @default("belum_bayar") @map("payment_status")
  paymentVerifiedAt DateTime?     @map("payment_verified_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  orderItems        OrderItem[]
  paymentProof      PaymentProof?
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String  @map("order_id")
  productId   String  @map("product_id")
  jumlah      Int
  hargaSatuan Int     @map("harga_satuan")
  subtotal    Int
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  @@map("order_items")
}

model PaymentProof {
  id        String   @id @default(cuid())
  orderId   String   @unique @map("order_id")
  mimeType  String   @map("mime_type")
  fileName  String   @map("file_name")
  fileData  Bytes    @map("file_data")
  createdAt DateTime @default(now()) @map("created_at")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId])
  @@map("payment_proofs")
}
