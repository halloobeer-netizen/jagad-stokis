# ════════════════════════════════════════════════════════════
# JAGAD STOCKIS - Environment Variables
# Salin file ini menjadi .env dan isi nilainya
# ════════════════════════════════════════════════════════════

# ── Database (PostgreSQL) ──────────────────────────────────
# Dari Neon: https://console.neon.tech → Project → Connection string
# Contoh: postgresql://user:password@ep-xxx.region.aws.neon.tech/jagad_stockis?sslmode=require
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# ── Admin Password ────────────────────────────────────────
# Password untuk mengakses Admin Panel
# GANTI dari default untuk keamanan!
ADMIN_PASSWORD=admin123

# ── Wablas WhatsApp API ───────────────────────────────────
# Dari dashboard Wablas: https://wablas.com
WABLAS_API_HOST=https://smg.wablas.com
WABLAS_TOKEN=token_wablas_anda_disini
WABLAS_ADMIN_PHONE=628xxxxxxxxxx

# ── WhatsApp Admin (client-side) ──────────────────────────
# Nomor WA admin untuk tombol wa.me di halaman sukses
# Awali dengan kode negara tanpa + (contoh: 6285774093995)
NEXT_PUBLIC_ADMIN_WA=628xxxxxxxxxx
